FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 8.3333333333e-05;

boundaryField
{
    inlet       { type fixedValue; value uniform 8.3333333333e-05; }
    outlet      { type zeroGradient; }
    upstreamWall { type fixedValue; value uniform 0; }
    lowerWall   { type fixedValue; value uniform 0; }
    stepWall    { type fixedValue; value uniform 0; }
    topWall     { type fixedValue; value uniform 0; }
    symmetry    { type symmetry; }
    frontAndBack { type empty; }
}
